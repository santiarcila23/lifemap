# Copie este archivo como .env (en el servidor) y complete los valores.
# .env NUNCA se sube a GitHub (está en .gitignore).

# --- Jenkins: usuario administrador que se crea solo ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambie-esta-clave
GIT_REPO_URL=https://github.com/USUARIO/lifemap.git
GIT_BRANCH=main
JENKINS_URL=http://localhost:8083/

# --- Kaggle (kaggle.com -> Settings -> API -> Create New Token: abre kaggle.json) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- ngrok: URL pública fija (dashboard.ngrok.com -> Your Authtoken / Domains) ---
NGROK_AUTHTOKEN=
NGROK_DOMAIN=su-dominio.ngrok-free.app

# --- Recursos (bájelos si el servidor tiene poca RAM) ---
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
DASK_WORKER_THREADS=2
DASK_WORKER_MEMORY=2GiB
